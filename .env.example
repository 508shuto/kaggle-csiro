# Environment variables for Kaggle CSIRO Competition
# Copy this file to .env and fill in your actual values
# .env is ignored by git (see .gitignore)

# Hugging Face Hub Token
# Required for accessing gated repositories (e.g., facebook/dinov3-vitl16-pretrain-lvd1689m)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weights & Biases API Key
# Required for experiment tracking
# Get your API key from: https://wandb.ai/settings
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kaggle Credentials
# Required for downloading datasets and submitting results
# Get your credentials from: https://www.kaggle.com/settings
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
